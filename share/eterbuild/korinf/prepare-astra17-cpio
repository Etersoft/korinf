#!/bin/sh
# Astra 1.7/1.8's cpio 2.13 regresses extraction of nested symbolic links.
# Use the Astra 1.7 package that passes korinf/check-cpio.
set -eu
mkdir -p /etc/apt/preferences.d
cat > /etc/apt/preferences.d/korinf-cpio <<'PIN'
Package: cpio
Pin: version 2.12+dfsg-9
Pin-Priority: 1001
PIN
if [ "$(dpkg-query -W -f='${Version}' cpio 2>/dev/null || true)" = '2.12+dfsg-9' ]; then
    exit 0
fi
if apt-cache show cpio=2.12+dfsg-9 2>/dev/null | grep -qx 'Version: 2.12+dfsg-9'; then
    apt-get --assume-yes --no-install-recommends --allow-downgrades install cpio=2.12+dfsg-9
else
    # Astra 1.8 no longer publishes this version. Do not add the whole 1.7 repo.
    [ "$(dpkg --print-architecture)" = amd64 ]
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT HUP INT TERM
    cd "$work"
    wget -O cpio.deb 'https://download.astralinux.ru/astra/stable/1.7_x86-64/repository-main/pool/main/c/cpio/cpio_2.12+dfsg-9_amd64.deb'
    echo '8241f240a01476d9e00a5d8345b68d793450e24bb2d4ff13c87676a8da298da7  cpio.deb' | sha256sum -c -
    chmod 755 "$work"
    apt-get --assume-yes --no-install-recommends --allow-downgrades install "$work/cpio.deb"
fi
