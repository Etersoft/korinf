#!/bin/sh
# Debian 10 build images use legacy .list sources. Its packages have
# moved to the archive. Keep signature checks; relax expiry only for this source.
set -eu
apt_dir=${1:-/etc/apt}
for source in "$apt_dir/sources.list" "$apt_dir"/sources.list.d/*.list; do
    [ -f "$source" ] || continue
    sed -E -i '
        /^[[:space:]]*deb(-src)?[[:space:]]/ {
            /[[:space:]]buster(-updates|\/updates)?([[:space:]]|$)/ {
                s#https?://(security.debian.org|deb.debian.org)/debian-security#https://archive.debian.org/debian-security#g
                s#https?://deb.debian.org/debian([/ ]|$)#https://archive.debian.org/debian\1#g
                /https:\/\/archive.debian.org\/debian/ {
                    /check-valid-until=/ {
                        s/check-valid-until=[^] ]+/check-valid-until=no/g
                    }
                    /check-valid-until=/! {
                        /\[/ {
                            s/\]/ check-valid-until=no]/
                        }
                        /\[/! {
                            s/^([[:space:]]*deb(-src)?[[:space:]]+)/\1[check-valid-until=no] /
                        }
                    }
                }
            }
        }
    ' "$source"
done
