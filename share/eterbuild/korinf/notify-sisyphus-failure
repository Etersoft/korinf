#!/usr/bin/env python3
"""Mail a failed Sisyphus build to the source RPM's latest changelog author."""
import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

CC = 'lav@etersoft.ru'

TARGETS = {'ALTLinux/Sisyphus': 'i586', 'i586/ALTLinux/Sisyphus': 'i586',
           'x86_64/ALTLinux/Sisyphus': 'x86_64'}
ADDRESS = re.compile(r'[A-Za-z0-9.!#$%&\'*+/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?\.[A-Za-z]{2,}')


def author(source):
    # Without array brackets RPM returns the first (latest) changelog entry.
    result = subprocess.run(['rpm', '-qp', '--qf', '%{CHANGELOGNAME}', str(source)],
                            capture_output=True, text=True, check=True, timeout=30)
    addresses = re.findall(r'<([^<>]+)>', result.stdout)
    addresses = [value for value in addresses if ADDRESS.fullmatch(value)]
    if len(addresses) != 1:
        raise ValueError('Latest changelog entry has no unique email address')
    return addresses[0]


def notify(dist, source, log, log_url='', version='', module='', state=None, dry_run=False):
    if dist not in TARGETS:
        return 'Skipped non-Sisyphus target'
    source, log = Path(source), Path(log)
    recipient = author(source)
    with log.open('rb') as stream:
        stream.seek(0, 2)
        stream.seek(max(0, stream.tell() - 16384))
        excerpt = stream.read().decode('utf-8', errors='replace')
    excerpt = re.sub(r'\x1b\[[0-9;]*[A-Za-z]', '', excerpt)
    failed_steps = re.findall(r'(?m)^STEP\s+.*$', excerpt)
    subject = f'Korinf: {source.name} failed on {dist}'
    body = (f'Сборка пакета под ALTLinux/Sisyphus завершилась ошибкой.\n\n'
            f'Исходный пакет: {source}\nАрхитектура: {TARGETS[dist]}\n'
            f'Система: {dist}\nВерсия продукта: {version or "не указана"}\n'
            f'KORINFMODULE: {module or "общий"}\n'
            f'Журнал: {log_url or str(log)}\nЛокальный журнал: {log}\n\n'
            f'Последние этапы:\n'+ '\n'.join(failed_steps[-5:]) +
            '\n\nКонец журнала:\n' + '\n'.join(excerpt.splitlines()[-45:]) +
            '\n\nАдрес получателя взят из последней записи changelog исходного RPM.\n')
    if dry_run:
        print(f'To: {recipient}\nCc: {CC}\nSubject: {subject}\n\n{body}')
        return 'Dry run; no mail sent'
    state = Path(state or Path.home() / '.korinf-notifications')
    state.mkdir(parents=True, exist_ok=True)
    # One source revision / product path / architecture / day, across retries.
    info = source.stat()
    key = [dt.date.today().isoformat(), str(source.resolve()), info.st_size,
           info.st_mtime_ns, TARGETS[dist]]
    digest = hashlib.sha256(json.dumps(key).encode()).hexdigest()
    with (state / (digest + '.lock')).open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        receipt = state / (digest + '.json')
        if receipt.exists():
            return 'Already notified today'
        subprocess.run(['mutt', '-s', subject, '-c', CC, '--', recipient], input=body, text=True,
                       check=True, timeout=30,
                       env=dict(os.environ, LC_ALL='C.UTF-8'))
        temporary = receipt.with_suffix('.tmp')
        temporary.write_text(json.dumps(dict(recipient=recipient, cc=CC, source=str(source),
                                             dist=dist, sent_at=dt.datetime.now().isoformat()))+'\n')
        temporary.replace(receipt)
    return 'Failure mail submitted to ' + recipient


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ('dist', 'source', 'log'):
        parser.add_argument('--' + name, required=True)
    for name in ('log-url', 'version', 'module'):
        parser.add_argument('--' + name, default='')
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()
    try:
        print(notify(**vars(args)))
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print('Cannot notify changelog author: ' + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
