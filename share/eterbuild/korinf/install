load_mod tarball

# install built packages
install_built_packages()
{
	assert_var DISTRNAME INTBUILT EPMCMD

	if [ -n "$BOOTSTRAP_EXCLUDE" ]; then
		case "$PKGFORMAT" in rpm|deb)
			run_in_chroot $dist "cd $INTBUILT && bash -s -- '$PKGFORMAT' '$BOOTSTRAP_EXCLUDE' ${EXPMAINFILES} ${EXPEXTRAFILES}" < "$KORINFDIR/korinf/install-bootstrap-packages"
			return $?
		;; esac
	fi
	
	#if [ $PKGVENDOR == "gentoo" ]
	#then
	#	run_in_chroot $dist "cd $INTBUILT && ls -a && ./${INSTALLBUILTSCRIPTNAME}"
	local opts=""
	# TODO: --force-overwrite since epm 3.64.2
	[ "$BUILDNAME" = "rpm-build-altlinux-compat" ] && opts="--nodeps"
	
	run_in_chroot $dist "cd $INTBUILT && ls -l && bash -x /usr/bin/epm --verbose --auto --force $opts install ${EXPMAINFILES} ${EXPEXTRAFILES}" && return
	local status="$?"

	echo "epm install status: $status"
	# if status is skipped
	if [ "$status" = "22" ] ; then
		return 22
	fi

	# it is failed for all packages except eepm and rpm-build-altlinux-compat
	if [ -z "$INITIALBOOTSTRAP" ] ; then
		set_build_failed
		return
	fi

	# Bootstrap install eepm (get command from host's epm)
	local INSTALLCOMMAND
	INSTALLCOMMAND=$(DISTRNAMEOVERRIDE=$DISTRNAME/$DISTRVERSION $EPMCMD --auto --show-command-only install) || { warning "Can't get install command" ; return 1 ; }
	[ -n "$INSTALLCOMMAND" ] || { warning "Got empty install command" ; return 1 ; }
	# Install only the first (base) package to avoid broken deps from subpackages (like eepm-repack)
	local BOOTSTRAPFILES="${EXPMAINFILES%% *}"
	# CHECKME: why we need yes here
	run_in_chroot $dist "cd $INTBUILT && yes | $INSTALLCOMMAND ${BOOTSTRAPFILES}" #|| set_build_failed
	if [ "$BUILDNAME" = "eepm" ] ; then
		run_in_chroot $dist "epm -h >/dev/null" || set_build_failed
	fi
}

# Pin only the affected Astra release, after refreshing its package indexes.
prepare_build_cpio()
{
	case "$PKGFORMAT:$DISTRNAME/$DISTRVERSION" in
		deb:AstraLinuxSE/1.7)
			run_in_chroot "$dist" "sh -s" < "$KORINFDIR/korinf/prepare-astra17-cpio"
			return $?
			;;
	esac
	return 0
}

# Install required packages for build under the system (f.i., Debian/6.0)
# Assure we have needed build requirements
install_build_requires()
{
	local reqs dist="$1"
	load_mod repl rpm

	assert_var BUILDNAME TARGETARCH BUILDARCH TARGETSRPM PKGFORMAT
	assert_var BUILDERHOME
	assert_var dist

	# Debian 11 security packages are now served from the signed archive.
	if [ "$DISTRNAME/$DISTRVERSION" = "Debian/11" ] && [ "$PKGFORMAT" = "deb" ]; then
		run_in_chroot $dist "sh -s" < "$KORINFDIR/korinf/prepare-debian11-container" || return
	fi

	# Prepare service handling before apt configures packages in Astra containers.
	if [ "$DISTRNAME" = "AstraLinuxSE" ] && [ "$PKGFORMAT" = "deb" ]; then
		run_in_chroot $dist "sh -s" < "$KORINFDIR/korinf/prepare-astra-container" || return
	fi

	# NOTE: possible side effect with redefined DISTRNAME, BUILDARCH, DISTRVERSION
	#parse_dist_name $dist

	# create needed files in home directory
	#init_home

	# Req build base system packages
	# Note: some additional requires we add in rpmbph
	# Note: sudo less for eepm
	# TODO: remove toolchain from this list
	local buildsystempkgs="libtool automake autoconf rpm-build glibc-devel gzip bzip2 pkg-config cpio patch gcc grep make rpm gawk sudo less ed which gettext"
	# coreutils-single

	if rhas "$BUILDNAME" "wine" && ! rhas "$BUILDNAME" "local" && ! rhas "$BUILDNAME" "network" ; then
		buildsystempkgs="$buildsystempkgs clang llvm lld flex bison"
	fi

	# hack to prepare Debian based system
	[ "$PKGFORMAT" = "deb" ] && buildsystempkgs="$buildsystempkgs build-essential alien fakeroot debhelper"

	# hack to prepare ArchLinux based system
	[ "$DISTRNAME" = "ArchLinux" ] && buildsystempkgs="$buildsystempkgs rpm-tools"

	# TODO: convert reqs only here due alt macros?
	# FIXME: get BR inside container!
	# Ordinary bootstrap packages still need their source BuildRequires.
	# Only the initial epm/build-tool bootstrap uses the base tool set alone.
	if [ -z "$INITIALBOOTSTRAP" ] ; then
		reqs="$($EPMCMD req "$TARGETSRPM" | grep -v "[<=>]" | xargs -n 1000 echo)"
		# Зависимости можно получить только из спека, придётся устанавливать src.rpm и разбирать спек (получать зависимости от пересборанного пакета?)
		#reqs="$(run_in_chroot $dist "epm req /home/$INTUSER/tmp/$(basename $TARGETSRPM)" </dev/null | grep -v "[<=>]" | xargs -n 1000 echo)"
	fi

	# super hack (reqs almost converted to target conventions (but only depends from BR)
	if echo "$reqs" | grep -q "python3-module-setuptools" ; then
		reqs="$(echo "$reqs" | sed -e 's|python3-module-setuptools||')"
		buildsystempkgs="$buildsystempkgs python3-module-setuptools"
	fi

	reqsbr="$(convert_pkgreqs_to_target $buildsystempkgs | xargs -n 1000 echo)"
	[ -z "$reqs$reqsbr" ] && return 0
	reqs="$(quote_pkgname $reqs)"
	reqsbr="$(quote_pkgname $reqsbr)"
	echo "reqs: $reqs"
	echo "reqsbr: $reqsbr"

	# run fixes only for rpm-build-altlinux-compat (as initial step)
	if  [ -n "$INITIALBOOTSTRAP" ] && [ "$BUILDNAME" = "rpm-build-altlinux-compat" ] ; then
		if [ "$PKGFORMAT" = "deb" ] && [ "$TARGETARCH" != "$BUILDARCH" ] ; then
			run_in_chroot $dist "dpkg --add-architecture i386" </dev/null
		fi

		if [ $DISTRNAME = "RockyLinux" ] ; then
			run_in_chroot $dist "epm --auto repo add epel ; epm --auto repo add powertools"
		fi

#		if [ "$DISTRNAME/$DISTRVERSION" = "AstraLinux/smolensk" ] ; then
#			# https://bugs.etersoft.ru/show_bug.cgi?id=15668#c12
#			run_in_chroot $dist "epm --auto install http://download.etersoft.ru/pub/download/astra-WE7xha2ia/ia32-libs_20220330+1.7se_amd64.deb"
#		fi

		if [ $DISTRNAME = "ROSA" ] ; then
			#run_in_chroot $dist "sed -i -e 's|executable-marked-as-config-file||' /usr/share/rpmlint/config.d/rosa.error.list"
			#cat <<EOF | run_in_chroot --user $dist "mkdir -p ~/.config/rpmlint/ && tee ~/.config/rpmlint"
			# https://www.apt-browse.org/browse/debian/jessie/main/all/rpmlint/1.6-2/file/etc/rpmlint/config
			# http://wiki.rosalab.ru/ru/index.php/Rpmlint
			cat <<EOF | run_in_chroot $dist "mkdir -p /etc/rpmlint/ && ! grep -q "subsys-not-used" /etc/rpmlint/config && tee -a /etc/rpmlint/config"
addFilter("E:.* subsys-not-used")
addFilter("E:.* postin-without-ldconfig")
addFilter("E:.* non-versioned-file-in-library-package")
addFilter("E:.* executable-marked-as-config-file")
addFilter("E:.* no-status-entry")
addFilter("E:.* no-chkconfig-line")
addFilter("E:.* init-script-name-with-dot")
addFilter("E:.* executable-in-library-package")
EOF
			# /tmp with noexec fails a test for %cross_compiling
			#run_in_chroot $dist "sed -i -e 's| /tmp/rpm| /var/tmp/rpm|g' /usr/lib/rpm/rosa/macros"
			# https://bugs.etersoft.ru/show_bug.cgi?id=15741#c3
			run_in_chroot $dist "cd /tmp ; epm -q libpython3-devel.i686 || epm download libpython3-devel.i686 && epm install --force --nodeps libpython3*.rpm "
		fi
	fi

	# prepare repository before install
	if [ -n "$BOOTSTRAP" ] ; then
		# safe input for eepm
		run_in_chroot $dist "epm --auto --verbose fix" </dev/null || warning "epm fix failure"
	fi

	# bootstrap install
#	if [ -n "$INITIALBOOTSTRAP" ] && [ "$BUILDNAME" = "eepm" ] ; then
	if [ -n "$INITIALBOOTSTRAP" ] ; then
		assert_var DISTRNAME
		local INSTALLCOMMAND
		# TODO: try use epm if exists
		#run_in_chroot "epm -h >/dev/null" || set_build_failed
		# The initial eepm bootstrap cannot rely on a working epm in the image.
		# Refresh apt indexes here too, including sources changed during preparation.
		if [ "$PKGFORMAT" = "deb" ]; then
			run_in_chroot $dist "apt-get -o Acquire::AllowReleaseInfoChange=true update" </dev/null || return
		fi
		prepare_build_cpio || return
		# Bootstrap install eepm (get command from host's epm)
		INSTALLCOMMAND=$(DISTRNAMEOVERRIDE=$DISTRNAME/$DISTRVERSION $EPMCMD --auto --show-command-only --nodeps install $reqsbr $reqs) || { warning "Can't get install command" ; return 1 ; }
		# CHECKME: why we need yes here
		run_in_chroot $dist "$INSTALLCOMMAND </dev/null" || return
	else
		# TODO: Appeared the backslashed quotes are required if package names contain parentheses
		# safe input for eepm
		# Per-distro build-env fixes (applied before install requires):
		# deb: allow apt release-info change — some repos change Origin metadata (e.g. OSnovaLinux onyx3)
		if [ "$PKGFORMAT" = "deb" ] ; then
			run_in_chroot $dist "echo 'Acquire::AllowReleaseInfoChange \"true\";' >/etc/apt/apt.conf.d/99korinf-allowrelinfo" </dev/null 2>/dev/null
		fi
		# ROSA: rpm IMA plugin can't apply signatures inside container (EPERM on fsm_file_prepare) — disable it
		[ "$DISTRNAME" = "ROSA" ] && run_in_chroot $dist "echo '%__transaction_ima %{nil}' >/etc/rpm/macros.korinf" </dev/null 2>/dev/null
		run_in_chroot $dist "epm --auto update" </dev/null || return
		prepare_build_cpio || return
		# RedOS 7.3: upgrade old binutils 2.30 -> 2.40 (2.30's `as` rejects --gdwarf-5 emitted by gcc 11)
		if [ "$DISTRNAME" = "RedOS" ] && [ "$DISTRVERSION" = "7.3" ] ; then
			run_in_chroot $dist "epm --auto upgrade binutils" </dev/null 2>/dev/null
		fi
		# ROSA: align stale fontconfig/gtk4 to repo versions — lib64*-devel (newer) conflicts on
		# /usr/share/doc/<pkg>/README.md with the older installed main package.
		# Also upgrade gcc/binutils: gcc 14.2's bundled `as` is linked against binutils 2.37 while
		# the module has binutils 2.43 (libopcodes-2.37.so missing) -> "C compiler cannot create executables".
		if [ "$DISTRNAME" = "ROSA" ] ; then
			run_in_chroot $dist "epm --auto upgrade fontconfig gtk4 gcc binutils" </dev/null 2>/dev/null
		fi
		# OSnovaLinux: stale module, t64 transition (libssl3->libssl3t64 and more) never done.
		# Run dist-upgrade directly via apt-get (allows removal) to do the whole transition.
		# NOTE: not used for AstraLinuxSE — its module is so stale that a full dist-upgrade
		# upgrades core packages and kills the container; epm install there allows removal anyway.
		if [ "$DISTRNAME" = "OSnovaLinux" ] ; then
			run_in_chroot $dist "apt-get -y dist-upgrade" </dev/null 2>/dev/null
		fi
		# Heal broken apt state before installing build requires.
		# e.g. eepm-full gets unpacked-but-not-configured (its Depends aria2/fzf/pigz are not pulled
		# during install_built_packages), which breaks all subsequent apt installs (clang/llvm/lld).
		run_in_chroot $dist "epm --auto fix" </dev/null || warning "epm fix failure (install requires)"

		# Recommends are not BuildRequires: e.g. valgrind:i386 pulls gdb:i386
		# and replaces the host Python/LLVM toolchain. Scope this to these calls.
		local buildreq_env=''
		if [ "$PKGFORMAT" = "deb" ]; then
			buildreq_env='APTOPTIONS="$APTOPTIONS --no-install-recommends"'
		fi

		# Allow the dependency solver to replace conflicting packages in build images.
		# Let the package manager update requested dependencies already installed.
		# --skip-installed kept stale ia32-libs in Astra build images indefinitely.
		run_in_chroot $dist "$buildreq_env epm --auto --verbose --allow-remove install $reqsbr" </dev/null
		RES=$?
		[ "$RES" = "0" ] || return "$RES"

		run_in_chroot $dist "$buildreq_env epm --auto --verbose --allow-remove install $reqs" </dev/null
		RES=$?
		[ "$RES" = "0" ] || return "$RES"

		# Installing dependencies may select a newer GCC; prepare its library paths too.
		if [ "$DISTRNAME" = "AstraLinuxSE" ] && [ "$PKGFORMAT" = "deb" ]; then
			run_in_chroot $dist "sh -s" < "$KORINFDIR/korinf/prepare-astra-container" || return
		fi

		if [ "$TARGETARCH" != "$BUILDARCH" ] && [ "$PKGFORMAT" = "rpm" ] ; then
			case "$DISTRNAME" in
				RedOS|CentOS|RockyLinux|Fedora|MSVSphere)
					# hack against architecture independent pkgconfig deps, see https://bugs.etersoft.ru/show_bug.cgi?id=14846#c9
					# FIXME: move hack with xargs -n1000 to epm
					# not all packages existed in i686
					#run_in_chroot $dist "epm --auto --verbose --skip-installed install $(epmqp devel .x86_64 | sed -e "s|\.x86_64|\.i686|" | xargs -n1000)" </dev/null || return
					run_in_chroot "$dist" "sh -s" < "$KORINFDIR/korinf/install-rpm-multilib" || return
					;;
			esac
		fi
	fi

	# Check behavior: older distro packages may carry the symlink fixes.
	if [ "$PKGFORMAT" = "deb" ]; then
		run_in_chroot "$dist" "sh -s" < "$KORINFDIR/korinf/check-cpio" || {
			warning "cpio cannot safely extract symlinks in $dist; install a fixed cpio package"
			return 1
		}
	fi

	# run fixes only for rpm-build-altlinux-compat (as initial step)
	[ -n "$INITIALBOOTSTRAP" ] && [ "$BUILDNAME" = "rpm-build-altlinux-compat" ] || return 0

	if [ "$DISTRNAME" = "ROSA" ] ; then
		run_in_chroot $dist 'cd /usr/share/rpmlint/config.d/ && test -r rosa.error.list && mv -f rosa.error.list rosa.error.list-disabled' </dev/null
	fi

	# FIXME: Ubuntu 22.04 and Debian 11 only for now
	if [ "$PKGFORMAT" = "deb" ] ; then
		# https://bugs.etersoft.ru/show_bug.cgi?id=14664#c4
		run_in_chroot $dist 'echo "true" >/usr/bin/dh_strip_nondeterminism' </dev/null
	fi

	# fix libdir macros on deb platforms
	libdir32="%{_prefix}/lib/i386-linux-gnu"
	libdir64="%{_prefix}/lib/x86_64-linux-gnu"
	if [ "$DISTRNAME" = "AstraLinuxCE" ] || [ "$DISTRNAME" = "AstraLinuxSE" ] ; then
		libdir32="%{_prefix}/lib32/i386-linux-gnu"
	fi
	
	if [ "$PKGFORMAT" = "deb" ] && [ "$TARGETARCH" != "$BUILDARCH" ] ; then
cat <<EOF | run_in_chroot $dist "mkdir -p /etc/rpm/$TARGETARCH-linux && tee /etc/rpm/$TARGETARCH-linux/macros"
# created with Korinf
# Inverted meaning!!!

# The system where built programs and libraries will run.
%_host            i686-redhat-linux-gnu
%_host_alias      i686-redhat-linux-gnu%{nil}
%_host_cpu        i686

# TODO: use standalone macros?
%_build            i686-redhat-linux-gnu
%_build_alias      i686-redhat-linux-gnu%{nil}
%_build_cpu        i686

# The system on which the package is built
#_build           x86_64-redhat-linux-gnu
#_build_alias     x86_64-redhat-linux-gnu%{nil}
#_build_cpu       x86_64
EOF
	fi

# biarch build (32 bit on 64 bit system)
	if [ "$PKGFORMAT" = "deb" ] && [ "$TARGETARCH" != "$BUILDARCH" ] ; then
cat <<EOF | run_in_chroot $dist "sed -i -e 's|^optflags: i586|optflags: i586 -O2 -g -m32 -march=i586|' /usr/lib/rpm/rpmrc ; mkdir -p /etc/rpm/$TARGETARCH-linux && tee /etc/rpm/$TARGETARCH-linux/macros"
# created with Korinf $(date)
# FIXME: by some reason really overrides in /usr/lib/rpm/rpmrc
%optflags               -O2 -g -m32 -g -march=i586

%__isa_name             x86
%__isa_bits             32
%__isa                  %{__isa_name}-%{__isa_bits}

# The default transaction color. This value is a set of bits to
# determine file and dependency affinity for this arch.
#       0       uncolored (i.e. use only arch as install hint)
#       1       Elf32 permitted
#       2       Elf64 permitted
%_transaction_color     0

#==============================================================================
# ---- configure macros.
#
%_libexecdir            %{_prefix}/lib
%_lib                   lib
%_libdir                $libdir32
EOF
	fi

# A container can report i586 while its GCC defaults to x86_64.
	if [ "$PKGFORMAT" = "deb" ] && [ "$TARGETARCH" = "i586" ] ; then
cat <<EOF | run_in_chroot $dist "sed -i -e 's|^optflags: i586.*|optflags: i586 -O2 -g -m32 -march=i586|' /usr/lib/rpm/rpmrc ; mkdir -p /etc/rpm/$TARGETARCH-linux && tee /etc/rpm/$TARGETARCH-linux/macros"
# created with Korinf $(date)

%optflags               -O2 -g -m32 -march=i586
%_libexecdir            %{_prefix}/lib
%_lib                   lib
%_libdir                $libdir32
EOF
	fi

# native 64 bit target
	if [ "$PKGFORMAT" = "deb" ] && [ "$TARGETARCH" = "x86_64" ] ; then
cat <<EOF | run_in_chroot $dist "mkdir -p /etc/rpm/$TARGETARCH-linux && tee /etc/rpm/$TARGETARCH-linux/macros"
# created with Korinf $(date)

%_libexecdir            %{_prefix}/lib
%_lib                   lib
%_libdir                $libdir64
EOF
	fi

}
