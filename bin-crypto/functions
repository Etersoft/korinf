#!/bin/bash

. `dirname $0`/config

set_module()
{
local ver="$1"
case $ver in
    0.5-9)
        # This compatibility release targets WINE@Etersoft 9.x.
        ver=9.0
        ;;
    0.4|0.5)
        # These CRYPTO releases build against stable WINE@Etersoft 11.6.
        ver=11.0
        ;;
esac
export KORINFMODULE=wine-$ver
}


set_ver()
{
    # System/Version [Version] [option]
    ver="$3"
    case "$ver" in
        -*|"")
            ver="$2"
            ;;
    esac

    case "$ver" in
        -*)
            ver=""
            ;;
    esac

    [ -n "$ver" ]|| ver="$DEFAULTVERSION"
    set_module "$ver"
    # libwine-devel has several providers in ALT. Use the stable WINE@Etersoft
    # toolchain selected by this product's build repository.
    case "$ver:$NAME" in
        0.4:wine-etersoft-cpcsp_proxy|0.5:wine-etersoft-cpcsp_proxy)
            case "$1" in
                x86_64/*) export ETERBUILD_HASHER_BUILD_PACKAGES=wine-etersoft-devel-tools ;;
                *) export ETERBUILD_HASHER_BUILD_PACKAGES=wine32-etersoft-devel-tools ;;
            esac
            ;;
    esac
}
