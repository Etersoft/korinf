#!/bin/bash

. `dirname $0`/config

set_module()
{
local ver="$1"
case $ver in
    0.4)
        ver=9.0
        ;;
    0.5-9)
        ver=9.0
        ;;
    0.5)
        ver=10.0
        ;;
esac
export KORINFMODULE=wine-$ver
}


set_ver()
{
    # System/Version [Version] [option]
    ver="$3"
    case "$ver" in
        -*|"")
            ver="$2"
            ;;
    esac

    case "$ver" in
        -*)
            ver=""
            ;;
    esac

    [ -n "$ver" ]|| ver="$DEFAULTVERSION"
    set_module "$ver"
}
