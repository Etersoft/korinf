#    TASKTYPE=winebuild
#    COMPONENTNAME="WINE@Etersoft"
#    PROJECTVERSION="11-testing"
#    DIST="x86_64/ALTLinux/p10"
#    [FORCE=1] [CLEAR_FAILED_ON_RESTART=1]
#
#  Runs bin-wine/wine-etersoft-bootstrap-new.sh for the system. Its output
#  goes to <sales>/winebuild/<taskid>.log, the stages with times to
#  <sales>/winebuild/<taskid>.progress (tab separated, read by buildapi):
#    start   <ts>
#    stage   <ts> <package> <dist>
#    step    <ts> DONE|SKIP|FAILED <text>
