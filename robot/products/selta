# A SELTA@Etersoft delivery (DOWNLOADDIR=SELTA@Etersoft/<version>):
#  * Windows/selta.msi and Windows/seltaEng.msi: the 32-bit ODBC driver for the
#    Windows clients (1C:Enterprise 7.7 is 32-bit, on Win64 too), required;
#    Windows/selta64.msi and Windows/seltaEng64.msi: the 64-bit one for 64-bit
#    applications, delivered when present. They are built outside korinf and
#    put to /var/ftp/pvt/Etersoft/SELTA@Etersoft/<version>/Windows as
#    selta-<version>-eter<rev>.{x86,x64}.msi with these links to them;
#  * <DIST>/selta-server-*.rpm: the server part (selta-pg-setup and the SELTA
#    schema for PostgreSQL for 1C), built by bin-selta for the system;
#  * <DIST>/postgresql-mchar-*: mchar for the PostgreSQL of the distribution,
#    not on ALT (PostgreSQL for 1C has its own);
#  * selta.lic: the license (for C:\Program Files\Selta).
# An order without a system (LICENSEONLY) gets only the license.

SELTA_PVT=${SELTA_PVT:-/var/ftp/pvt/Etersoft}
SELTA_MSI="selta.msi seltaEng.msi"
SELTA_MSI64="selta64.msi seltaEng64.msi"

prepareSeltaMail()
{
	local FILETO=$1
	>$FILETO
	NAME="$(get_dear_from_fio "$FULLNAME" "покупатель")"

	if [ "$TYPE_LICENSE" = "Demo" ] ; then
		THANKTEXT="Благодарим Вас за внимание к нашему продукту."
	else
		THANKTEXT="Благодарим Вас за покупку!"
	fi

	cat >>$FILETO <<EOF
${DEAR} ${NAME}!

Ваш заказ Продукта ${PRODUCT} (релиз $PROJECTVERSION) выполнен.

Регистрационный номер Продукта: ${ETERREGNUM}.

Для получения Продукта необходимо скачать файлы по приведённым ссылкам.

Установочные пакеты SELTA@Etersoft для клиентов Windows: 32-битный драйвер ODBC
(selta.msi, английская версия seltaEng.msi). Он нужен 1С:Предприятию 7.7
и другим 32-битным приложениям, в том числе в 64-битной Windows:
EOF
	printURL "$FTPDIR/Windows" "$DOWNLOADDIR/$PROJECTVERSION/Windows" $MSIFILES >>$FILETO || fatal "Error with MSI packages (files are missed)"

	if [ -n "$MSIFILES64" ] ; then
		cat >>$FILETO <<EOF

64-битный драйвер ODBC для 64-битных приложений в 64-битной Windows
(selta64.msi, английская версия seltaEng64.msi):
EOF
		printURL "$FTPDIR/Windows" "$DOWNLOADDIR/$PROJECTVERSION/Windows" $MSIFILES64 >>$FILETO || fatal "Error with 64-bit MSI packages (files are missed)"
		cat >>$FILETO <<EOF

32-битный и 64-битный драйверы можно установить на один компьютер.
64-битный драйвер заменяет драйвер ODBC «SQL Server» для всех 64-битных
программ; 32-битные программы продолжают работать с 32-битным драйвером.
EOF
	fi

	cat >>$FILETO <<EOF

Файл лицензии:
EOF
	printURL "$FTPDIR" "$DOWNLOADDIR/$PROJECTVERSION" $LICENSEFILE >>$FILETO || fatal "Error with license (files are missed)"

	cat >>$FILETO <<EOF

Файл лицензии $LICENSEFILE необходимо расположить в каталоге $LICENSEDIR
на клиентах Windows.

Новую версию драйвера устанавливайте после удаления прежней
(через «Установка и удаление программ»).

EOF
	if [ -n "$MCHARFILES" ] ; then
		cat >>$FILETO <<EOF
Серверная часть SELTA для системы ${TEXTDIST} (selta-server) и модуль mchar
для PostgreSQL системы (postgresql-mchar):
EOF
	else
		cat >>$FILETO <<EOF
Серверная часть для PostgreSQL для 1C в системе ${TEXTDIST}:
EOF
	fi
	printURL "$FTPDIR/$DIST" "$DOWNLOADDIR/$PROJECTVERSION/$DIST" $SERVERFILES $MCHARFILES >>$FILETO || fatal "Error with selta-server (files are missed)"

	if [ -n "$MCHARFILES" ] ; then
		cat >>$FILETO <<EOF

SELTA работает с PostgreSQL одним из двух способов:
 - с PostgreSQL системы: установите оба пакета, postgresql-mchar установит
   PostgreSQL системы (версии 12 и новее);
 - с PostgreSQL для 1С (например, Postgres Pro для 1С: epm play postgrespro-1c):
   установите его и только пакет selta-server.
EOF
	fi

	cat >>$FILETO <<EOF

После установки пакета настройте PostgreSQL для SELTA командой
	selta-pg-setup init --allow <сеть клиентов>
а после обновления пакета обновите схему SELTA в базах командой
	selta-pg-setup upgrade

Вы можете напрямую зайти в каталог, чтобы загрузить файлы:
	${DOWNLOADDIR}/$PROJECTVERSION

Документация и краткая инструкция по установке доступна по адресу
https://wiki.etersoft.ru/SELTA

По вопросам использования продукта пишите на selta@etersoft.ru, указав
в теме письма регистрационный номер.

Пожалуйста, отвечайте на это письмо только
при возникновении затруднений со скачиванием файлов.

$THANKTEXT

--
Команда разработчиков
Etersoft, 2026
EOF
}

# PostgreSQL for 1C is in ALT (and has mchar); elsewhere selta-server runs
# on PostgreSQL for 1C installed by hand or on the PostgreSQL of the
# distribution with postgresql-mchar
selta_with_mchar()
{
	case "$DIST" in
		ALTLinux/*|*/ALTLinux/*|XimperLinux/*|*/XimperLinux/*)
			return 1
			;;
	esac
	return 0
}

# The driver checks DATE_START against the UTC date (GetSystemTime), the order
# has a Moscow date: a license of the day of the order would not work till
# 03:00 MSK (and for a day west of UTC). Start it a day earlier.
selta_date_start()
{
	local d m y
	IFS=/ read -r d m y <<EOF
$DATE_START
EOF
	DATE_START=$(date -d "$y-$m-$d -1 day" +%d/%m/%Y 2>/dev/null) || fatal "Wrong DATE_START $d/$m/$y (DD/MM/YYYY)"
}

build_selta()
{
	local PROJ=$DOWNLOADDIR
	local i n
	# old orders have no DOWNLOADDIR
	[ -n "$PROJ" ] || PROJ="SELTA@Etersoft/$PROJECTVERSION"
	LOCALDIR=$SELTA_PVT/$PROJ

	# Use real path if possible
	# NOTE: replace PROJECTVERSION with linked version
	if [ -L "$LOCALDIR" ] ; then
		LOCALDIR=`readlink -f "$LOCALDIR"`
		PROJECTVERSION=`basename $LOCALDIR`
		PROJ=`dirname $PROJ`/$PROJECTVERSION
	fi
	[ -d "$LOCALDIR" ] || fatal "SELTA@Etersoft $PROJECTVERSION is missed ($LOCALDIR)"

	TEXTDIST=$DIST
	# Check for linked system (собираем для основной системы)
	if [ -L "$LOCALDIR/$DIST" ] ; then
		DIST=`readlink $LOCALDIR/$DIST | sed -e "s|\.\./||g"`
		TEXTDIST="$TEXTDIST (фактически сборка выполнена для $DIST)"
	fi

	if [ -z "$LICENSEONLY" ] ; then
		check_dist $DIST
	fi

	# will do FTPDIR from it in create_license_dir
	TARGETDIR=/var/ftp/pub/download/SELTA@Etersoft/$TARGETDIRNAME
	DOWNLOADDIR="$MPROTO://$DOWNLOADDOMAIN/pub/download/SELTA@Etersoft/$TARGETDIRNAME"

	LICENSEFILE=selta.lic
	LICENSEDIR="C:\\Program Files\\Selta"
	[ -n "$KORINF_CHECK_ONLY" ] || selta_date_start

	# Для отправки писем обязательно нужна локаль!
	export LC_ALL=ru_RU.UTF-8

	if [ -n "$LICENSEONLY" ] ; then
		[ -z "$KORINF_CHECK_ONLY" ] || return 0
		# exports FTPDIR
		create_license_dir
		TMPMAIL=$(make_temp_file)
		prepare_license_mail $TMPMAIL selta@etersoft.ru || fatal "Can't prepare letter"
		order_delivery "$TARGETDIRNAME/$PROJECTVERSION"
		order_ready "$FTPDIR"
		cat $TMPMAIL | mutt "${FULLMAILTO}" -b "sales-track@etersoft.ru" -s "$ETERREGNUM: Лицензия для продукта $COMPONENTNAME $PROJECTVERSION" || fatal "Can't send"
		rm -f $TMPMAIL
		return 0
	fi

	# the MSI packages are built outside korinf: they must be in place
	MSIFILES=''
	for i in $SELTA_MSI ; do
		[ -r "$LOCALDIR/Windows/$i" ] || fatal "Missed $i in $LOCALDIR/Windows"
		MSIFILES="$MSIFILES $i"
	done
	# the 64-bit driver: both of its packages or none
	MSIFILES64=''
	for i in $SELTA_MSI64 ; do
		[ -r "$LOCALDIR/Windows/$i" ] && MSIFILES64="$MSIFILES64 $i"
	done
	if [ -n "$MSIFILES64" ] && [ "$(echo $MSIFILES64)" != "$SELTA_MSI64" ] ; then
		fatal "Only$MSIFILES64 of $SELTA_MSI64 is in $LOCALDIR/Windows"
	fi

	check_and_refresh_component bin-selta $LOCALDIR selta-server
	assert_present_package $LOCALDIR/$DIST selta-server
	if selta_with_mchar ; then
		check_and_refresh_component bin-selta $LOCALDIR postgresql-mchar
		assert_present_package $LOCALDIR/$DIST postgresql-mchar
	fi

	task_require_ready
	[ -z "$KORINF_CHECK_ONLY" ] || return 0

	# exports FTPDIR
	create_license_dir

	SERVERFILES=''
	n="$(echo $LOCALDIR/$DIST/selta-server[-_][0-9]*)"
	[ -r "$n" ] || fatal "Missed selta-server package in $LOCALDIR/$DIST"
	SERVERFILES="$(basename $n)"
	MCHARFILES=''
	if selta_with_mchar ; then
		n="$(echo $LOCALDIR/$DIST/postgresql-mchar[-_][0-9]*)"
		[ -r "$n" ] || fatal "Missed postgresql-mchar package in $LOCALDIR/$DIST"
		MCHARFILES="$(basename $n)"
	fi

	# Нужно скопировать файлы (жёсткими ссылками, если можно)
	mkdir -p $FTPDIR/Windows $FTPDIR/$DIST
	for i in $MSIFILES $MSIFILES64 ; do
		# the links selta.msi -> selta-<version>-eter<rev>.msi: copy the file under the link name
		n="$(readlink -f $LOCALDIR/Windows/$i)"
		cp -fl $n $FTPDIR/Windows/$i || cp -f $n $FTPDIR/Windows/$i || fatal "Can't copy $i"
	done
	for i in $SERVERFILES $MCHARFILES ; do
		n="$LOCALDIR/$DIST/$i"
		cp -fl $n $FTPDIR/$DIST || cp -f $n $FTPDIR/$DIST || fatal "Can't copy $n"
	done

	# a personal order (orders API): its delivery directory is ready
	order_delivery "$TARGETDIRNAME/$PROJECTVERSION"
	order_ready "$FTPDIR"

	TMPMAIL=$(make_temp_file)
	prepareSeltaMail $TMPMAIL || fatal "Can't prepare letter"
	cat $TMPMAIL | mutt "${FULLMAILTO}" -b "sales-track@etersoft.ru" -s "$ETERREGNUM: Сборка $COMPONENTNAME $PROJECTVERSION" || fatal "Can't send"
	rm -f $TMPMAIL
}
