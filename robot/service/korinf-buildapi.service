[Unit]
Description=Korinf build queue API + web (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=builder
Group=builder
WorkingDirectory=/srv/builder/Projects/korinf/buildapi
Environment=PYTHONUNBUFFERED=1
# :: listens on IPv4 too (net.ipv6.bindv6only=0): builder64.office.etersoft.ru may resolve to ::1 there
ExecStart=/bin/python3 -m uvicorn main:app --host :: --port 5503 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
