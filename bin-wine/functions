#!/bin/bash

. `dirname $0`/config

set_module()
{
local ver="$1"
case $ver in
    1.0.12*)
        ver=1
        ;;
    2*)
        ver=2
        ;;
    5*)
        ver=5
        ;;
    6*)
        ver=6
        ;;
    7-unstable)
        ver=7-unstable
        ;;
    7.15)
        ver=7-unstable
        ;;
    7.13)
        ver=7
        ;;
    7*)
        ver=7-unstable
        ;;
    8.0*)
        ver=7-unstable
        ;;
    8.1*|8-testing)
        ver=8.12
        ;;
    8.2*|8-unstable)
        ver=8.12
        #ver=8.20
        ;;
    9.*|9-testing|9-unstable)
        ver=9.0
        ;;
    9*wow64*)
        ver=9.0-wow64
        ;;
    10*)
        ver=10.0
        ;;
esac
export KORINFMODULE=wine-$ver
}


set_ver()
{
    # System/Version [Version] [option]
    ver="$3"
    case "$ver" in
        -*|"")
            ver="$2"
            ;;
    esac

    case "$ver" in
        -*)
            ver=""
            ;;
    esac

    [ -n "$ver" ]|| ver="$DEFAULTVERSION"
    set_module "$ver"
}
